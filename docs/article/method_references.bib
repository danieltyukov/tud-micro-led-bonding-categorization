% Method references for the electrical-characterization section of
% "Contactless Die Attach Methods Via Solder Paste".
%
% IEEE only. Every entry was found on IEEE Xplore through the TU Delft Library
% proxy, the metadata below was taken from the Xplore record itself, and the
% full text was downloaded and read. PDFs are in ./references/.
%
% Five references, one per method that actually needs support. Keys prefixed m_
% so they cannot clash with keys already in the article.

% ---------------------------------------------------------------------------
% Daisy-chain resistance across dummy dies, and the sheet-resistance method
% ---------------------------------------------------------------------------

@inproceedings{m_abdelwahab2025,
  author    = {Abdelwahab, Ahmed and {van Zeijl}, Henk and {van Hoorn}, Remco and
               Kuipers, Hans and Mastrangeli, Massimo},
  title     = {Pick-and-Release: A Novel Contactless Bonding Method for Die Attachment},
  booktitle = {2025 IEEE 75th Electronic Components and Technology Conference (ECTC)},
  pages     = {2125--2132},
  year      = {2025},
  month     = may,
  publisher = {IEEE},
  doi       = {10.1109/ECTC51687.2025.00363},
  note      = {PDF: references/ECTC2025\_Abdelwahab\_pick\_and\_release.pdf.
               Section E defines the structure the new figure measures: a daisy chain
               bridging six 1 mm x 1 mm dummy dies, on a PCB also carrying van der Pauw
               and TLM structures and RGB-LED footprints, read on a Summit 11K/12K probe
               station. Sheet resistance on a CDE ResMap 178 multi-probe station.
               Reported chain resistances 0.199 +/- 0.019 ohm (Ag, with pressure) to
               0.380 +/- 0.025 ohm (Au, pressure-less)},
}

% ---------------------------------------------------------------------------
% Ideality factor as a quality and defect indicator
% ---------------------------------------------------------------------------

@article{m_zhanghu2024,
  author  = {Zhanghu, Mengyuan and Liu, Yibo and Hyun, Byung-Ryool and Li, Yanfei and
             Liu, Zhaojun},
  title   = {Optimizing {InGaN} Micro-{LED} Efficiency: Investigating the Internal
             Quantum Efficiency and Ideality Factor Connection},
  journal = {IEEE Transactions on Electron Devices},
  volume  = {71},
  number  = {10},
  pages   = {6190--6197},
  year    = {2024},
  month   = oct,
  doi     = {10.1109/TED.2024.3449829},
  note    = {PDF: references/TED2024\_Zhanghu\_ideality\_factor\_IQE\_microLED.pdf.
             Gives the reading of the ideality factor that justifies an acceptance
             window: n = 1 band-to-band radiative recombination, n = 2 SRH via defect
             levels, n > 2 deep-level-assisted tunnelling. Also reports an inverse
             correlation between ideality factor and internal quantum efficiency, and
             notes that leakage paths raise the apparent series resistance},
}

% ---------------------------------------------------------------------------
% Parallel conduction path across the junction
% ---------------------------------------------------------------------------

@article{m_jung2015,
  author  = {Jung, Eunjin and Lee, June Key and Kim, Min Soo and Kim, Hyunsoo},
  title   = {Leakage Current Analysis of {GaN}-Based Light-Emitting Diodes Using a
             Parasitic Diode Model},
  journal = {IEEE Transactions on Electron Devices},
  volume  = {62},
  number  = {10},
  pages   = {3322--3325},
  year    = {2015},
  month   = oct,
  doi     = {10.1109/TED.2015.2468581},
  note    = {PDF: references/TED2015\_Jung\_leakage\_parasitic\_diode\_model.pdf.
             Treats LED leakage as a parasitic shunt bypassing the main diode and
             separates the two by their turn-on voltages, 2.64 V main against 0.94 V
             parasitic. Their shunt is intrinsic, ours is assembly contamination, so
             cite it for the model and the diagnostic, not the mechanism},
}

% ---------------------------------------------------------------------------
% Pulsed measurement and self-heating
% ---------------------------------------------------------------------------

@article{m_roccato2024,
  author  = {Roccato, Nicola and Piva, Francesco and Buffolo, Matteo and
             Trivellin, Nicola and {De Santi}, Carlo and Narduzzi, Claudio and
             Fraccaroli, Riccardo and Caria, Alessandro and Meneghesso, Gaudenzio and
             Zanoni, Enrico and Meneghini, Matteo},
  title   = {Fast Characterization of Power {LED}s: Circuit Design and Experimental
             Results},
  journal = {IEEE Transactions on Electron Devices},
  volume  = {71},
  number  = {6},
  pages   = {3753--3760},
  year    = {2024},
  month   = jun,
  doi     = {10.1109/TED.2024.3393448},
  note    = {PDF: references/TED2024\_Roccato\_fast\_characterization\_power\_LEDs.pdf.
             States directly that LED characterization is often done with pulses of
             10 ms and longer, conditions in which self-heating can significantly
             affect the result. This is the published justification for choosing a
             short current-on time},
}

% ---------------------------------------------------------------------------
% Forward voltage against junction temperature, and its effect on resistance
% ---------------------------------------------------------------------------

@article{m_gacio2013,
  author  = {Gacio, David and Alonso, J. Marcos and Garcia, Jorge and
             Perdig{\~a}o, Marina S. and {Sousa Saraiva}, E. and Bisogno, F{\'a}bio E.},
  title   = {Effects of the Junction Temperature on the Dynamic Resistance of White
             {LED}s},
  journal = {IEEE Transactions on Industry Applications},
  volume  = {49},
  number  = {2},
  pages   = {750--760},
  year    = {2013},
  month   = mar,
  doi     = {10.1109/TIA.2013.2243092},
  note    = {PDF: references/TIA2013\_Gacio\_junction\_temperature\_dynamic\_resistance.pdf.
             Defines V_D = V_D(25 C) + lambda (T_j - 25) with lambda the forward-voltage
             temperature coefficient, measures lambda for four commercial LEDs, and
             measures how junction temperature shifts the dynamic resistance. Also
             chooses its pulse width as a trade-off between signal-to-noise and
             negligible self-heating, the same argument we make},
}
